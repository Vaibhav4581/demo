{
  "version": 2,
  "cleanUrls": true,
  "rewrites": [
    {
      "source": "/download",
      "destination": "https://github.com/Vaibhav4581/demo/releases/latest/download/app-debug.apk"
    },
    {
      "source": "/app-debug.apk",
      "destination": "https://github.com/Vaibhav4581/demo/releases/latest/download/app-debug.apk"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "X-XSS-Protection",
          "value": "1; mode=block"
        }
      ]
    }
  ]
}
